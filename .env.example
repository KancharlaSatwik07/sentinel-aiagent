# Server-side only. Never use a VITE_ prefix or commit a populated .env file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional: pin a specific OpenRouter free model (must use a free model ID).
OPENROUTER_FALLBACK_MODEL=

# Vercel hosted requests require ENABLE_PUBLIC_AI=1 after adding authentication,
# rate limits, abuse monitoring, and budget controls in the deployment.
ENABLE_PUBLIC_AI=0

# Code execution is local-only and runs with your user privileges.
# Keep disabled unless you explicitly trust every file submitted for testing.
ALLOW_TRUSTED_CODE=0
